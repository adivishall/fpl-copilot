# Public entry point (docker-compose.public.yml, docs/DEPLOYMENT.md "Public deployment").
# Internet → this TLS proxy → web (Next.js, which proxies /backend/* to the API with a key the
# browser never sees) → API → PostgreSQL / Redis / worker. Only this service publishes ports.
{
	# certificates: an ACME e-mail address (Let's Encrypt, renewed automatically) or "internal"
	# (Caddy's own CA, for a local test only); never touch the host's trust store
	skip_install_trust

	# request URIs carry manager keys (query and path); error entries must not log them
	log default {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

{$FPL_PUBLIC_DOMAIN} {
	tls {$FPL_TLS}

	# Optional outer site login (docs/DEPLOYMENT.md "Public deployment"): auth.caddy holds a
	# basic_auth block (generate it from auth.caddy.example) or is empty, which turns the gate
	# off — the invite-only accounts are the authentication since M1.1a. The file must exist:
	# a missing file stops Caddy rather than silently serving an unintended configuration.
	import /etc/caddy/auth.caddy

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
	# no access log: request URLs carry manager keys (the API redacts them in its own logs)

	# The versioned API, for a front end hosted elsewhere (the Vercel deployment's server-side
	# proxy, docs/DEPLOYMENT.md "A front end on another host"): the same key-gated routes the
	# web container calls over the Compose network. Nothing else of the API is published — its
	# /metrics, /docs and /openapi.json stay on the private network.
	handle /api/v1/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
